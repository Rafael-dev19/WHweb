# ================================================================
# Wooden House — .htaccess /public/  (DocumentRoot)
# ================================================================
Options -Indexes -ExecCGI

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ── www.muebleswh.com → muebleswh.com (301) ──
    # Sin esto, las dos direcciones servían el mismo contenido y Google las
    # veía como páginas duplicadas.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # /index.php → / (misma página que la portada)
    RewriteCond %{THE_REQUEST} \s/index\.php[\s?] [NC]
    RewriteRule ^index\.php$ / [L,R=301]

    # ── Forzar HTTPS (excepto localhost, 127.0.0.1 y proxies que ya terminan SSL) ──
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^localhost(:\d+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:\d+)?$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Sitemap dinámico
    RewriteRule ^sitemap\.xml$               sitemap.php                     [L]

    # Rutas directas a paneles (sin condiciones para evitar conflicto con directorios reales)
    # Un panel por rol: jefe/administrador siguen en /admin, empleado en /empleado;
    # ventas y disenador ahora tienen su propio panel separado.
    RewriteRule ^admin/?$                    admin/panel_administrador.php       [L,QSA]
    RewriteRule ^empleado/?$                 empleado/panel_empleado.php         [L,QSA]
    RewriteRule ^ventas/?$                   ventas/panel_ventas.php             [L,QSA]
    RewriteRule ^disenador/?$                disenador/panel_disenador.php       [L,QSA]

    # No reescribir si el archivo o directorio ya existe
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Rutas limpias (aplica solo cuando no es archivo/directorio existente)
    RewriteRule ^$                           index.php                       [L,QSA]
    RewriteRule ^inicio/?$                   index.php                       [L,QSA]
    RewriteRule ^catalogo/?$                 catalogo.php                    [L,QSA]
    RewriteRule ^login/?$                    login.php                       [L,QSA]
    RewriteRule ^carrito/?$                  carrito-checkout.php            [L,QSA]
    RewriteRule ^pago/?$                     pago.php                        [L,QSA]
    RewriteRule ^solicitudes/?$              solicitudes.php                 [L,QSA]
    RewriteRule ^seguimiento/?$              seguimiento.php                 [L,QSA]
    RewriteRule ^detalle/([0-9]+)/?$         detalle_producto.php?id=$1      [L,QSA]
    RewriteRule ^mi-cuenta/?$                mi-cuenta.php                   [L,QSA]
    RewriteRule ^terminos/?$                 terminos.php                    [L,QSA]
    RewriteRule ^privacidad/?$               privacidad.php                  [L,QSA]
    RewriteRule ^acceso-denegado/?$          acceso-denegado.php             [L,QSA]
</IfModule>

# Bloquear archivos sensibles
<FilesMatch "\.(env|log|bak|sh|lock|yaml|yml|gitignore|sql)$">
    Require all denied
</FilesMatch>
<Files ".env">
    Require all denied
</Files>

# ── Archivos internos ─────────────────────────────────────────────
# _dev_*.php (login de pruebas sin contraseña) solo responde desde la propia
# máquina: aunque se suba por error al servidor, desde internet da 403.
# Los demás _*.php son parciales que se incluyen desde otras páginas
# (ej. _modal_pedido_manual.php) — nunca se piden directo.
<FilesMatch "^_dev_">
    Require local
</FilesMatch>
<FilesMatch "^_(?!dev_).*\.php$">
    Require all denied
</FilesMatch>

# ── Seguridad HTTP ────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always unset Server
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=(self), usb=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header always set Cross-Origin-Resource-Policy "same-origin"

    # Content-Security-Policy: la genera PHP con nonce por carga (includes/csp.php).


    # Sin caché para PHP
    <FilesMatch "\.php$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate"
        Header always set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ── Caché para assets estáticos ───────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg             "access plus 6 months"
    ExpiresByType image/png              "access plus 6 months"
    ExpiresByType image/webp             "access plus 6 months"
    ExpiresByType image/svg+xml          "access plus 1 month"
    ExpiresByType font/woff2             "access plus 1 year"
</IfModule>

# ── Compresión ────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Llaves de Firebase (cuenta de servicio) y archivos temporales del editor
# (.swp de vim puede contener el .env completo) — nunca se sirven.
<FilesMatch "(firebase-adminsdk.*|service-account.*)\.json$|\.sw[op]$|~$">
    Require all denied
</FilesMatch>
