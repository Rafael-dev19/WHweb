rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Productos - solo usuarios autenticados (admin/empleado) pueden subir
    match /productos/{allPaths=**} {
      allow read: if true;        // Lectura pública (para mostrar en catálogo)
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType in [
                        'image/jpeg', 'image/png', 'image/webp', 'image/gif'
                      ];
    }
    // Proyectos - igual
    match /proyectos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType in [
                        'image/jpeg', 'image/png', 'image/webp', 'image/gif'
                      ];
    }
    // Diseñador: archivo de corte para CNC (VCarve → .dxf) adjunto a un
    // pedido — no es imagen, por eso no entra en la regla de arriba. Se
    // valida por extensión del nombre (el navegador no tiene un content-type
    // estándar para DXF) y tamaño; ver api/pedidos.php para la validación
    // de que el diseñador adjunte render+corte antes de liberar a producción.
    match /proyectos/pedidos/{pedidoId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && fileName.matches('.*[.]dxf')
                   && request.resource.size < 25 * 1024 * 1024;
    }
    // Cotizaciones - imágenes del cliente (Fase 8) y del jefe (Fase 6)
    match /cotizaciones/{cotId}/cliente/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType in [
                        'image/jpeg', 'image/png', 'image/webp', 'image/gif'
                      ];
    }
    // También sirve la nota de voz opcional del jefe al responder (audio/*).
    match /cotizaciones/{cotId}/jefe/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType in [
                        'image/jpeg', 'image/png', 'image/webp', 'image/gif'
                      ] || request.resource.contentType.matches('audio/.*'));
    }
    // Pedidos cargados a mano por jefe/diseñador (encargos de WhatsApp) —
    // fotos de referencia y nota de voz que describen el proyecto.
    match /pedidos/{pedidoTmp}/adjuntos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && (request.resource.contentType in [
                        'image/jpeg', 'image/png', 'image/webp', 'image/gif'
                      ] || request.resource.contentType.matches('audio/.*'));
    }

    // PDF de la propuesta de cotización (generado en el navegador del jefe).
    // Un wildcard de segmento completo no puede mezclarse con texto literal
    // (ej. "propuesta_{fileName}" no es válido) — el nombre del archivo ya
    // incluye el prefijo "propuesta_" del lado de la app, no de la regla.
    match /cotizaciones/{cotId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }
  }
}
