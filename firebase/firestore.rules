rules_version = '2';
// Firestore solo lo usan el servidor PHP (con cuenta de servicio — ver
// includes/firebase_admin.php) y la Cloud Function (Admin SDK). Ambos
// ignoran estas reglas, así que para cualquier navegador todo queda cerrado.
//
// ANTES estaba abierto (lectura pública y creación sin sesión porque PHP
// usaba la API key pública): cualquiera podía leer los datos de clientes que
// viajan en las notificaciones y crear documentos que la Cloud Function
// convierte en correos/push. Publicar estas reglas SOLO después de configurar
// FIREBASE_SERVICE_ACCOUNT_FILE en el .env del servidor; si no, los avisos
// por correo/push dejan de salir.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
